# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only secret key for Admin Client. Never expose to the browser.
SUPABASE_SECRET_KEY=your-secret-key

# Web Push (VAPID)
# Generate with: npx web-push generate-vapid-keys
# Public key only may be exposed to the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only — never put NEXT_PUBLIC_ prefix on the private key.
VAPID_PRIVATE_KEY=
# Contact for push service (mailto:)
VAPID_SUBJECT=mailto:regapro.2019.02@gmail.com
